[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.1
reloadable = true

[libraries]
linux.debug.x86_64 =     "res://../rust/mimesys/target/debug/libmimesys.so"
linux.release.x86_64 =   "res://../rust/mimesys/target/release/libmimesys.so"
windows.debug.x86_64 =   "res://../rust/mimesys/target/debug/mimesys.dll"
windows.release.x86_64 = "res://../rust/mimesys/target/release/mimesys.dll"
macos.debug =            "res://../rust/mimesys/target/debug/libmimesys.dylib"
macos.release =          "res://../rust/mimesys/target/release/libmimesys.dylib"
macos.debug.arm64 =      "res://../rust/mimesys/target/debug/libmimesys.dylib"
macos.release.arm64 =    "res://../rust/mimesys/target/release/libmimesys.dylib"
